---
import { PROVIDERS } from 'Constants';
import IndexCard from 'Components/IndexCard/index.astro';
import SectionHeading from 'Components/SectionHeading/index.astro';

const groups = [
  {
    source: 'no network',
    title: 'Read from disk',
    items: PROVIDERS.filter(p => p.source === 'local'),
  },
  {
    source: 'key in Keychain',
    title: 'Official APIs',
    items: PROVIDERS.filter(p => p.source === 'api'),
  },
];
---

<section class='page-sec' data-reveal id='providers'>
  <SectionHeading number='§4 · Providers' title='Ten sources.' />
  <div class='grid items-start gap-x-6 gap-y-7 pt-9 sm:grid-cols-2'>
    {groups.map(group => (
      <IndexCard source={group.source} title={group.title}>
        <ul class='plist'>
          {group.items.map(provider => (
            <li>
              {provider.name}
              {provider.beta && <span class='beta'>beta</span>}
            </li>
          ))}
        </ul>
      </IndexCard>
    ))}
  </div>
</section>

<style>
  .plist {
    list-style: none;
    margin: 12px 0 0;
    padding: 0;
  }

  .plist li {
    align-items: center;
    display: flex;
    font-size: 15px;
    gap: 8px;
    height: 26px;
  }

  .beta {
    border: 1px solid var(--color-margin);
    color: var(--color-margin);
    font-size: 11px;
    line-height: 16px;
    padding: 0 5px;
  }
</style>
