---
import RabojPopover from 'Islands/RabojPopover';
import Stamp from 'Components/Stamp/index.astro';
import CopyCommand from 'Components/CopyCommand/index.astro';
import { APP_VERSION, BREW_INSTALL, GITHUB_URL, RELEASES_URL } from 'Constants';
---

<section aria-labelledby='hero-title' class='scene' data-scene>
  <div class='stage'>
    <div class='book' data-book>
      <div class='first-page ruled'>
        <div aria-hidden='true' class='margin-line page-margin'></div>
        <div class='first-content'>
          <div>
            <p class='sec-no'>Page 1</p>
            <h1 class='hero-title' id='hero-title'>
              Keep count of every AI account.
            </h1>
            <p class='hero-text'>
              Plan limits, tokens and cost for Claude Code, Codex, Gemini CLI and your API
              keys, one line per account, in your Mac’s menu bar.
            </p>
            <div class='hero-actions'>
              <Stamp href={RELEASES_URL} label='Download · free' />
              <CopyCommand command={BREW_INSTALL} />
            </div>
          </div>
          <div class='clip'>
            <p aria-hidden='true' class='slip' data-slip>
              Try it: click an account <b>↘</b>
            </p>
            <RabojPopover client:idle hint />
          </div>
        </div>
      </div>
      <div aria-hidden='true' class='ribbon'></div>
      <div aria-hidden='true' class='scroll-cue'>
        Scroll to open <b>↓</b>
      </div>
      <div class='cover idle' data-cover>
        <div class='cover-face'>
          <div class='label'>
            <p class='label-no'>Usage ledger · Nº {APP_VERSION}</p>
            <p class='label-name'>Răboj</p>
            <div class='label-rule'></div>
            <p class='label-text'>Every AI account, one line each.</p>
            <a class='open-hint' data-open href='#accounts'>
              Open the ledger <span aria-hidden='true'>↓</span>
            </a>
          </div>
        </div>
        <div class='cover-back'></div>
      </div>
    </div>
    <p class='desk-note'>
      Free for macOS 14+ · <a href={RELEASES_URL}>Download</a> ·{' '}
      <a href={GITHUB_URL}>Source</a>
    </p>
  </div>
</section>

<style>
  @property --peek {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .scene {
    background: var(--color-desk);
    height: 230vh;
    position: relative;
  }

  .stage {
    background:
      repeating-linear-gradient(
        92deg,
        rgb(0 0 0 / 0.08) 0 2px,
        transparent 2px 23px,
        rgb(255 255 255 / 0.025) 23px 25px,
        transparent 25px 61px
      ),
      radial-gradient(ellipse 70% 60% at 50% 45%, var(--color-desk-2), var(--color-desk));
    display: grid;
    height: 100vh;
    overflow: hidden;
    perspective: 2600px;
    place-items: center;
    position: sticky;
    top: 0;
  }

  .book {
    --open: 0;
    --grow: 0;
    border-radius: calc(6px * (1 - var(--grow)));
    box-shadow: 0 calc(40px * (1 - var(--grow))) 80px -20px rgb(0 0 0 / 0.6);
    height: calc(min(700px, 80vh) + (100vh - min(700px, 80vh)) * var(--grow));
    position: relative;
    transform-style: preserve-3d;
    width: calc(min(1080px, 92vw) + (100vw - min(1080px, 92vw)) * var(--grow));
  }

  .first-page {
    border-radius: inherit;
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    inset: 0;
    overflow: hidden;
    position: absolute;
  }

  .page-margin {
    box-shadow: inset -30px 0 40px -30px rgb(0 0 0 / 0.25);
  }

  .first-content {
    align-items: center;
    display: grid;
    gap: 40px;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 0;
    padding: clamp(24px, 5vh, 56px) clamp(20px, 4vw, 56px);
  }

  .hero-title {
    font-family: var(--font-print);
    font-size: clamp(40px, 6.4vw, 88px);
    font-weight: 700;
    line-height: 0.92;
    margin: 0;
    max-width: 10ch;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .hero-text {
    font-size: 17px;
    line-height: 32px;
    margin: 16px 0 0;
    max-width: 38ch;
  }

  .hero-actions {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 22px 28px;
    margin-top: 28px;
  }

  .clip {
    position: relative;
    transform: rotate(1.6deg);
  }

  .clip::before {
    background: rgb(240 228 180 / 0.8);
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.15);
    content: '';
    height: 24px;
    left: 50%;
    position: absolute;
    top: -13px;
    transform: translateX(-50%) rotate(-3deg);
    width: 76px;
    z-index: 1;
  }

  .slip {
    background: var(--color-card);
    border-left: 3px solid var(--color-margin);
    box-shadow: 0 8px 16px -10px rgb(29 43 79 / 0.5);
    font-size: 13px;
    left: -64px;
    margin: 0;
    padding: 8px 12px;
    position: absolute;
    top: -52px;
    transform: rotate(-5deg);
    transition: opacity 0.3s;
    white-space: nowrap;
    z-index: 2;
  }

  .slip b {
    color: var(--color-margin);
  }

  .slip.gone {
    opacity: 0;
  }

  .cover {
    border-radius: 6px 10px 10px 6px;
    inset: 0;
    position: absolute;
    transform: rotateY(calc(var(--open) * -176deg + var(--peek)));
    transform-origin: left center;
    transform-style: preserve-3d;
  }

  .cover.idle {
    animation: peek 4.2s ease-in-out 1.2s infinite;
  }

  .cover-face,
  .cover-back {
    backface-visibility: hidden;
    border-radius: inherit;
    inset: 0;
    position: absolute;
  }

  .cover-face {
    background-color: var(--color-cloth);
    background-image:
      repeating-linear-gradient(
        45deg,
        rgb(255 255 255 / 0.035) 0 1px,
        transparent 1px 3px
      ),
      repeating-linear-gradient(-45deg, rgb(0 0 0 / 0.08) 0 1px, transparent 1px 3px),
      linear-gradient(
        90deg,
        var(--color-cloth-2) 0 34px,
        rgb(0 0 0 / 0.25) 34px 36px,
        transparent 36px
      );
    box-shadow:
      inset 0 0 0 1px rgb(255 255 255 / 0.06),
      inset 0 -8px 20px rgb(0 0 0 / 0.3);
    display: grid;
    padding-left: 36px;
    place-items: center;
  }

  .cover-back {
    background: var(--color-cloth-2);
    background-image:
      radial-gradient(circle at 20% 30%, rgb(199 162 74 / 0.18), transparent 30%),
      radial-gradient(circle at 70% 70%, rgb(194 66 58 / 0.14), transparent 35%);
    transform: rotateY(180deg);
  }

  .label {
    background: var(--color-label);
    border: 1px solid rgb(0 0 0 / 0.2);
    box-shadow:
      0 0 0 6px var(--color-label),
      0 0 0 7px var(--color-foil),
      0 10px 24px rgb(0 0 0 / 0.35);
    padding: 28px 30px 24px;
    text-align: center;
    width: min(440px, 80%);
  }

  .label-no {
    color: var(--color-pencil);
    font-family: var(--font-print);
    font-size: 12px;
    letter-spacing: 0.2em;
    margin: 0;
    text-transform: uppercase;
  }

  .label-name {
    font-family: var(--font-print);
    font-size: clamp(44px, 7vw, 76px);
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1;
    margin: 6px 0 4px;
    text-transform: uppercase;
  }

  .label-rule {
    border-top: 3px double var(--color-ink);
    margin: 14px 0 12px;
  }

  .label-text {
    font-size: 15px;
    margin: 0;
  }

  .open-hint {
    align-items: center;
    display: inline-flex;
    font-family: var(--font-print);
    font-size: 12px;
    gap: 8px;
    letter-spacing: 0.14em;
    margin-top: 14px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .open-hint span,
  .scroll-cue b {
    animation: nudge 1.5s ease-in-out infinite;
    display: inline-block;
  }

  .ribbon {
    animation: sway 3.2s ease-in-out infinite;
    background: linear-gradient(90deg, #8f1d17, var(--color-stamp) 40%, #8f1d17);
    bottom: -74px;
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 82%, 0 100%);
    height: 92px;
    left: 68%;
    opacity: calc(1 - var(--open) * 4);
    position: absolute;
    transform-origin: top;
    width: 26px;
  }

  .scroll-cue {
    bottom: -64px;
    color: var(--color-label);
    display: flex;
    flex-direction: column;
    font-family: var(--font-print);
    font-size: 12px;
    gap: 2px;
    left: calc(68% + 40px);
    letter-spacing: 0.16em;
    opacity: calc(1 - var(--open) * 4);
    position: absolute;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .scroll-cue b {
    font-size: 20px;
    line-height: 1;
  }

  .desk-note {
    bottom: calc(18px + env(safe-area-inset-bottom, 0px));
    color: rgb(239 230 207 / 0.75);
    font-size: 13px;
    left: 0;
    margin: 0;
    position: absolute;
    right: 0;
    text-align: center;
  }

  .desk-note a {
    color: var(--color-label);
  }

  @keyframes peek {
    0%,
    62%,
    100% {
      --peek: 0deg;
    }
    72% {
      --peek: -14deg;
    }
    80% {
      --peek: -9deg;
    }
    88% {
      --peek: -12deg;
    }
  }

  @keyframes sway {
    50% {
      transform: rotate(4deg);
    }
  }

  @media (max-width: 820px), (prefers-reduced-motion: reduce) {
    .scene {
      height: auto;
    }

    .stage {
      display: block;
      height: auto;
      padding: 40px max(16px, env(safe-area-inset-right, 0px)) 0
        max(16px, env(safe-area-inset-left, 0px));
      perspective: none;
      position: relative;
    }

    .book {
      box-shadow: none;
      display: flex;
      flex-direction: column;
      height: auto;
      transform: none;
      width: auto;
    }

    .cover {
      animation: none !important;
      border-radius: 6px 10px 0 0;
      height: 360px;
      order: -1;
      position: relative;
      transform: none;
    }

    .cover-back,
    .ribbon,
    .scroll-cue {
      display: none;
    }

    .first-page {
      border-radius: 0;
      margin: 0 calc(-1 * max(16px, env(safe-area-inset-right, 0px))) 0
        calc(-1 * max(16px, env(safe-area-inset-left, 0px)));
      position: relative;
    }

    .first-content {
      padding-block: 40px 56px;
    }

    .desk-note {
      padding: 14px 0 18px;
      position: static;
    }
  }

  @media (max-width: 820px) {
    .first-page {
      grid-template-columns: 42px minmax(0, 1fr);
    }

    .first-content {
      grid-template-columns: minmax(0, 1fr);
    }

    .slip {
      left: 8px;
      top: -46px;
    }

    .clip {
      margin-top: 40px;
    }
  }
</style>

<script>
  import { HINT_DISMISSED_EVENT } from 'Constants/events';

  const scene = document.querySelector<HTMLElement>('[data-scene]');
  const book = document.querySelector<HTMLElement>('[data-book]');
  const cover = document.querySelector<HTMLElement>('[data-cover]');
  const flat = matchMedia('(max-width: 820px), (prefers-reduced-motion: reduce)');

  const clamp = (value: number) => Math.min(1, Math.max(0, value));
  const ease = (t: number) => (t < 0.5 ? 2 * t * t : 1 - (-2 * t + 2) ** 2 / 2);

  const update = () => {
    if (!scene || !book || !cover || flat.matches) return;
    const travel = scene.offsetHeight - innerHeight;
    const progress = clamp(-scene.getBoundingClientRect().top / travel);
    book.style.setProperty('--open', ease(clamp(progress / 0.62)).toFixed(4));
    book.style.setProperty('--grow', ease(clamp((progress - 0.62) / 0.3)).toFixed(4));
    cover.classList.toggle('idle', progress < 0.01);
  };

  const openLedger = (event: Event) => {
    if (!scene || flat.matches) return;
    event.preventDefault();
    const travel = scene.offsetHeight - innerHeight;
    scrollTo({ behavior: 'smooth', top: scene.offsetTop + travel * 0.95 });
  };

  const hideSlip = () => document.querySelector('[data-slip]')?.classList.add('gone');

  update();
  addEventListener('scroll', update, { passive: true });
  addEventListener('resize', update);
  addEventListener(HINT_DISMISSED_EVENT, hideSlip);
  document.querySelector('[data-open]')?.addEventListener('click', openLedger);
</script>
